diff -ruN eden_v1/src/android/app/src/main/java/org/yuzu/yuzu_emu/utils/PvclCrashReport.kt eden/src/android/app/src/main/java/org/yuzu/yuzu_emu/utils/PvclCrashReport.kt
--- eden_v1/src/android/app/src/main/java/org/yuzu/yuzu_emu/utils/PvclCrashReport.kt	1970-01-01 00:00:00.000000000 +0000
+++ eden/src/android/app/src/main/java/org/yuzu/yuzu_emu/utils/PvclCrashReport.kt	2026-11-13 09:26:35.510901171 +0000
@@ -0,0 +1,70 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package org.yuzu.yuzu_emu.utils
+
+import android.app.ActivityManager
+import android.app.ApplicationExitInfo
+import android.content.Context
+import android.os.Build
+import org.yuzu.yuzu_emu.getPublicFilesDir
+import java.io.File
+
+/**
+ * PVCL: reads the last native crash recorded by Android (tombstone) and writes it to the Eden log
+ * and to files/log/pvcl_last_crash.txt, because a native crash leaves no trace in the normal log.
+ */
+object PvclCrashReport {
+    private const val MAX_LINES = 400
+    private const val MAX_LINE_LENGTH = 220
+
+    fun dumpLastNativeCrash(context: Context) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) {
+            return
+        }
+        try {
+            val manager = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
+            val reasons = manager.getHistoricalProcessExitReasons(context.packageName, 0, 8)
+            val prefs = context.getSharedPreferences("pvcl_crash", Context.MODE_PRIVATE)
+            val lastSeen = prefs.getLong("last_timestamp", 0L)
+            val crash = reasons.firstOrNull {
+                it.reason == ApplicationExitInfo.REASON_CRASH_NATIVE && it.timestamp > lastSeen
+            } ?: return
+            prefs.edit().putLong("last_timestamp", crash.timestamp).apply()
+
+            val lines = ArrayList<String>()
+            lines.add("PVCL: last native crash - pid=${crash.pid} timestamp=${crash.timestamp}")
+            lines.add("PVCL: description=${crash.description}")
+
+            val bytes = crash.traceInputStream?.use { it.readBytes() }
+            if (bytes == null) {
+                lines.add("PVCL: Android did not provide a tombstone for this crash")
+            } else {
+                lines.add("PVCL: tombstone strings (${bytes.size} bytes):")
+                val current = StringBuilder()
+                fun flush() {
+                    if (current.length >= 5 && lines.size < MAX_LINES) {
+                        lines.add("PVCL: " + current.toString().take(MAX_LINE_LENGTH))
+                    }
+                    current.setLength(0)
+                }
+                for (b in bytes) {
+                    val c = b.toInt() and 0xFF
+                    if (c in 0x20..0x7E) {
+                        current.append(c.toChar())
+                    } else {
+                        flush()
+                    }
+                }
+                flush()
+            }
+
+            lines.forEach { Log.error(it) }
+            val dir = File(context.getPublicFilesDir(), "log")
+            dir.mkdirs()
+            File(dir, "pvcl_last_crash.txt").writeText(lines.joinToString("\n"))
+        } catch (e: Throwable) {
+            Log.warning("PVCL: could not read last crash: ${e.message}")
+        }
+    }
+}
