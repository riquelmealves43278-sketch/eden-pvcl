+// PVCL: lets the user make Eden ignore optional extensions, to find which one crashes the driver.
+void PvclHideExtensions(std::set<std::string, std::less<>>& supported) {
+    if (!Settings::values.pvcl_enabled.GetValue()) {
+        return;
+    }
+    struct Entry {
+        bool hide;
+        const char* name;
+        const char* label;
+    };
+    const bool safe_mode = Settings::values.pvcl_safe_mode.GetValue();
+    const Entry entries[] = {
+        {Settings::values.pvcl_hide_push_descriptor.GetValue(), VK_KHR_PUSH_DESCRIPTOR_EXTENSION_NAME, "VK_KHR_push_descriptor"},
+        {Settings::values.pvcl_hide_conditional_rendering.GetValue(), VK_EXT_CONDITIONAL_RENDERING_EXTENSION_NAME, "VK_EXT_conditional_rendering"},
+        {Settings::values.pvcl_hide_draw_indirect_count.GetValue(), VK_KHR_DRAW_INDIRECT_COUNT_EXTENSION_NAME, "VK_KHR_draw_indirect_count"},
+        {Settings::values.pvcl_hide_custom_border_color.GetValue(), VK_EXT_CUSTOM_BORDER_COLOR_EXTENSION_NAME, "VK_EXT_custom_border_color"},
+        {Settings::values.pvcl_hide_provoking_vertex.GetValue(), VK_EXT_PROVOKING_VERTEX_EXTENSION_NAME, "VK_EXT_provoking_vertex"},
+        {Settings::values.pvcl_hide_line_rasterization.GetValue(), VK_EXT_LINE_RASTERIZATION_EXTENSION_NAME, "VK_EXT_line_rasterization"},
+        {Settings::values.pvcl_hide_index_type_uint8.GetValue(), VK_EXT_INDEX_TYPE_UINT8_EXTENSION_NAME, "VK_EXT_index_type_uint8"},
+    };
+    for (const Entry& entry : entries) {
+        if ((safe_mode || entry.hide) && supported.erase(std::string{entry.name}) > 0) {
+            LOG_WARNING(Render_Vulkan, "PVCL: hiding extension {}", entry.label);
+        }
+    }
+}
