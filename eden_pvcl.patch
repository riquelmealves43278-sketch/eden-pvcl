+bool PvclTolerates(const char* name) {
+    if (!Settings::values.pvcl_enabled.GetValue()) {
+        return false;
+    }
+    static constexpr std::array<std::string_view, 6> tolerated{
+        "samplerAnisotropy",   "fillModeNonSolid",
+        "dualSrcBlend",        "multiViewport",
+        "shaderImageGatherExtended", "shaderDemoteToHelperInvocation",
+    };
+    return std::ranges::find(tolerated, std::string_view{name}) != tolerated.end();
+}
